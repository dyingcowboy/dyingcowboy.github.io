---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Xuanshi Xi',
  description = '席轩石的学习与实践档案。记录项目、学习和思考，以及每一步如何形成。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header />
    <div class="site-workspace">
      <div class="workspace-bar"><span>PERSONAL LEARNING ARCHIVE</span><a href="/trajectories/?import=1">本地导入 <span aria-hidden="true">↗</span></a></div>
      <main id="main-content" class="site-shell">
        <slot />
      </main>
      <Footer />
    </div>
    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
    <script>
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
          event.preventDefault();
          const search = document.querySelector<HTMLInputElement>('[data-archive-search]');
          if (search) search.focus();
          else window.location.href = '/trajectories/?search=1';
        }
      });
    </script>
  </body>
</html>
