---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import '../styles/prose.css';

const page = await getEntry('pages', 'about');
if (!page || page.data.kind !== 'page') throw new Error('缺少关于页内容：src/content/pages/about.md');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="article">
    <PageHeading title={page.data.title} eyebrow={page.data.eyebrow} />
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
