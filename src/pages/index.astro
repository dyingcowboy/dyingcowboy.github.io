---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { publicTrajectories } from '../lib/archive';
import { cardHtml, formatDate } from '../lib/presentation';
import { publicLearning } from '../lib/learning';
import { selectFeaturedProjects } from '../lib/page-content';
import '../styles/home.css';

const page = await getEntry('pages', 'home');
if (!page || page.data.kind !== 'home') throw new Error('缺少首页内容：src/content/pages/home.md');
const home = page.data;
const { Content } = await render(page);
const projects = selectFeaturedProjects(home.featuredCourseIds, publicLearning.projects);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const recent = [...publicTrajectories]
  .sort((a, b) => (b.updatedAt ?? '').localeCompare(a.updatedAt ?? '')).slice(0, 4);
const historicalNotes = notes.slice(0, Math.max(0, 3 - publicLearning.notes.length));
---

<BaseLayout description={home.description}>
  <section class="home-hero">
    <div class="hero-copy">
      <span class="eyebrow">{site.name} <span class="hero-slash">/</span> {site.chineseName}</span>
      <h1>{home.title}</h1>
      <div class="hero-intro"><Content /></div>
      <div class="hero-actions">
        <a class="button primary" href={home.primaryAction.href}>{home.primaryAction.label}<Icon name="arrow" size={16} /></a>
        <a class="hero-github" href={site.links.github}><Icon name="github" size={18} />GitHub<Icon name="upRight" size={14} /></a>
      </div>
      <div class="hero-caption"><span class="live-dot"></span>{home.caption}</div>
    </div>
    <div class="process-sketch" aria-label={home.process.description}>
      <span class="sketch-label">{home.process.label}</span>
      <ol class="process-steps">
        {home.process.steps.map((step, index) => (
          <li>
            <div class:list={['sketch-line', { last: index === home.process.steps.length - 1 }]}>
              <span class="sketch-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{step.title}</strong><span>{step.description}</span></div>
            </div>
            {step.transition && index < home.process.steps.length - 1 && (
              <div class="sketch-connector" aria-hidden="true"><span></span><em>{step.transition}</em></div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section topics-section">
    <div class="section-heading"><h2>{home.sections.courses.title}<span>{home.sections.courses.eyebrow}</span></h2></div>
    <div class="topic-grid">
      {projects.map((project) => (
        <a class="topic-card" href={`/learning/${project.id}/`}>
          <div class="topic-icon"><Icon name="book" size={21} /></div>
          <div><h3>{project.title}</h3><p>{project.description}</p></div>
          <Icon name="upRight" size={17} />
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>{home.sections.trajectories.title}<span>{home.sections.trajectories.eyebrow}</span></h2>
      <a href="/trajectories/">{home.archive.allLabel}<Icon name="arrow" size={16} /></a>
    </div>
    <div class="notice home-notice"><Icon name="note" size={17} /><span id="home-archive-notice" data-local-notice={home.archive.localNotice}>{home.archive.notice}</span></div>
    <div class="trajectory-grid" id="recent-trajectories" set:html={recent.map((trajectory) => cardHtml(trajectory)).join('')} />
  </section>

  <section class="section home-notes">
    <div class="section-heading">
      <h2>{home.sections.notes.title}<span>{home.sections.notes.eyebrow}</span></h2>
      <a href="/notes/">{home.notes.allLabel}<Icon name="arrow" size={16} /></a>
    </div>
    <div>
      {publicLearning.notes.slice(0, 3).map((note) => (
        <article class="home-note-row">
          <span class="note-index">↗</span>
          <div>
            <h3><a href={`/learning/notes/${note.id}/`}>{note.title}</a></h3>
            <span>{publicLearning.projects.find((project) => project.id === note.projectId)?.title} · {home.notes.repositoryLabel}</span>
          </div>
          <time datetime={note.observedAt}>{formatDate(note.observedAt, true)}</time>
          <Icon name="upRight" size={17} />
        </article>
      ))}
      {historicalNotes.map((note, index) => (
        <article class="home-note-row">
          <span class="note-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
            <span>{home.notes.historicalLabel} · {note.data.tags.slice(0, 3).join(' · ')}</span>
          </div>
          <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date.toISOString(), true)}</time>
          <Icon name="upRight" size={17} />
        </article>
      ))}
    </div>
  </section>
  <script>import '../scripts/home';</script>
</BaseLayout>
