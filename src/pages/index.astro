---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const recentNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(date);
---

<BaseLayout>
  <section class="home-lead">
    <p class="role">{profile.role}</p>
    <h1>{profile.name}<span class="cn-name"> / {profile.chineseName}</span></h1>
    <p class="interests">{profile.focus}</p>
  </section>

  <section class="section prose-width">
    <h2 class="section-label">Bio</h2>
    <p>{profile.bio}</p>
  </section>

  <section class="section prose-width">
    <h2 class="section-label">Currently</h2>
    <p>{profile.currently}</p>
  </section>

  <section class="section">
    <h2 class="section-label">Recent Notes</h2>
    {recentNotes.length === 0 ? (
      <p class="page-intro">Notes will appear here as they are published.</p>
    ) : (
      <div class="archive-list">
        {recentNotes.map((note) => (
          <article class="archive-item">
            <div class="archive-title"><a href={`/notes/${note.id}/`}>{note.data.title}</a></div>
            <time class="archive-date" datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
          </article>
        ))}
      </div>
    )}
    <p class="meta"><a href="/notes/">all notes →</a></p>
  </section>

  <section class="section">
    <h2 class="section-label">Identity</h2>
    <div class="prompt-block" aria-label="Terminal-style signature">
      <div class="prompt-line"><span class="prompt">$</span> whoami</div>
      <div class="prompt-line">{profile.name}</div>
    </div>
  </section>
</BaseLayout>
