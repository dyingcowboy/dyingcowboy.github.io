---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { publicLearning } from '../../lib/learning';
import { projectHtml } from '../../lib/learning-presentation';
import '../../styles/learning.css';

const page = await getEntry('pages', 'learning');
if (!page || page.data.kind !== 'page') throw new Error('缺少课程索引内容：src/content/pages/learning.md');
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="section">
    <PageHeading title={page.data.title} eyebrow={page.data.eyebrow}><Content /></PageHeading>
    <p class="learning-sync" data-learning-sync>{publicLearning.generatedAt ? `公开快照 · ${new Date(publicLearning.generatedAt).toLocaleDateString('zh-CN')}` : '等待首次同步'}</p>
  </section>
  <div class="learning-grid" data-learning-grid set:html={publicLearning.projects.map((project) => projectHtml(project)).join('')} />
  <script>import '../../scripts/learning-page';</script>
</BaseLayout>
