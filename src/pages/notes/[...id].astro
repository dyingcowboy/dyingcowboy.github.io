---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
const date = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(note.data.date);
---

<BaseLayout title={`${note.data.title} — Xuanshi Xi`} description={note.data.description ?? note.data.title}>
  <article class="article">
    <header class="article-header">
      <h1 class="article-title">{note.data.title}</h1>
      <div class="article-meta">
        <time datetime={note.data.date.toISOString()}>{date}</time>
        {note.data.tags.length > 0 && ` · ${note.data.tags.join(' · ')}`}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="section meta">
      <a href="/notes/">← notes archive</a>
    </footer>
  </article>
</BaseLayout>
