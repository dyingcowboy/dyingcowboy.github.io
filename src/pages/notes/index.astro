---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title="Notes — Xuanshi Xi">
  <section class="section">
    <h1 class="page-title">Notes</h1>
    <p class="page-intro">Technical notes kept as a chronological archive. Most of them grow out of study, implementation, and debugging.</p>
  </section>

  <section class="section archive-list" aria-label="Notes archive">
    {notes.length === 0 ? (
      <p class="page-intro">No public notes yet.</p>
    ) : (
      notes.map((note) => (
        <article class="archive-item">
          <div class="archive-title"><a href={`/notes/${note.id}/`}>{note.data.title}</a></div>
          <time class="archive-date" datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
        </article>
      ))
    )}
  </section>
</BaseLayout>
