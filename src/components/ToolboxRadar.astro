---
import { radarGeometry, type DisplayModule } from '../lib/toolbox';

interface Props {
  modules: DisplayModule[];
}

const { modules } = Astro.props;
const geo = radarGeometry(modules);
const totalChars = modules.reduce((total, module) => total + module.chars, 0);
const started = modules.filter((module) => module.chars > 0).length;
---

<figure class="tb-radar" aria-labelledby="tb-radar-caption">
  <svg
    viewBox="-215 -178 430 356"
    role="img"
    aria-label={`人生工具箱六模块分布：${modules.length} 个模块中 ${started} 个已有内容，共 ${totalChars} 字`}
  >
    <!-- 底网：三层同心六边形 + 六条辐条 -->
    <g class="tb-radar-grid">
      {geo.rings.map((ring) => <polygon points={ring.points} />)}
      {geo.spokes.map((spoke) => <line x1={spoke.x1} y1={spoke.y1} x2={spoke.x2} y2={spoke.y2} />)}
    </g>

    <!-- 内容量多边形：半径越远，这一模块写得越多 -->
    <polygon class="tb-radar-area" points={geo.polygon} />

    {geo.axes.map((axis) => (
      <g class:list={['tb-radar-axis', `is-${axis.maturity}`]}>
        <circle cx={axis.x} cy={axis.y} r="4" />
        <text
          class="tb-radar-label"
          x={axis.labelX}
          y={axis.labelY + (axis.anchor === 'middle' ? (axis.labelY < 0 ? 0 : 12) : 4)}
          text-anchor={axis.anchor}
        >{axis.label}</text>
        <text
          class="tb-radar-value"
          x={axis.labelX}
          y={axis.labelY + (axis.anchor === 'middle' ? (axis.labelY < 0 ? 13 : 25) : 17)}
          text-anchor={axis.anchor}
        >{axis.chars > 0 ? `${axis.chars} 字` : '待建'}</text>
      </g>
    ))}

    <!-- 圆心：总量 -->
    <g class="tb-radar-core">
      <text class="tb-radar-core-value" x="0" y="0" text-anchor="middle">{totalChars}</text>
      <text class="tb-radar-core-unit" x="0" y="14" text-anchor="middle">字</text>
    </g>
  </svg>
  <figcaption id="tb-radar-caption">
    <span class="tb-radar-legend"><i class="is-filled"></i>已有内容</span>
    <span class="tb-radar-legend"><i class="is-empty"></i>待建</span>
    <span class="tb-radar-note">半径 = 内容量</span>
  </figcaption>
</figure>

<style>
  .tb-radar {
    margin: 0;
    padding: 18px 18px 14px;
    background: linear-gradient(140deg, #f3f7f2, #f9faf8);
    border: 1px solid #e4ece2;
    border-radius: 7px;
  }

  .tb-radar svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .tb-radar-grid polygon {
    fill: none;
    stroke: #dde6dc;
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .tb-radar-grid polygon:last-of-type {
    stroke: #cfdccf;
    stroke-dasharray: none;
  }

  .tb-radar-grid line {
    stroke: #e2eae1;
    stroke-width: 1;
  }

  .tb-radar-area {
    fill: rgba(40, 118, 93, 0.12);
    stroke: #28765d;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .tb-radar-axis circle {
    fill: #fff;
    stroke: #28765d;
    stroke-width: 1.6;
  }

  .tb-radar-axis.is-empty circle {
    fill: #f9faf8;
    stroke: #b9c9bd;
    stroke-dasharray: 2 2.5;
  }

  .tb-radar-label {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    fill: var(--text);
    letter-spacing: 0.2px;
  }

  .tb-radar-axis.is-empty .tb-radar-label {
    fill: #7d8a83;
  }

  .tb-radar-value {
    font-family: var(--mono);
    font-size: 8px;
    fill: #93a096;
    letter-spacing: 0.3px;
  }

  .tb-radar-core-value {
    font-family: var(--mono);
    font-size: 19px;
    fill: #5f6f66;
    dominant-baseline: middle;
  }

  .tb-radar-core-unit {
    font-family: var(--mono);
    font-size: 8px;
    fill: #a2aea6;
    letter-spacing: 0.6px;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #e6ede4;
    font: 8px var(--mono);
    letter-spacing: 0.4px;
    color: #8d9c90;
  }

  .tb-radar-legend {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tb-radar-legend i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.4px solid #28765d;
    background: rgba(40, 118, 93, 0.25);
  }

  .tb-radar-legend i.is-empty {
    border-color: #b9c9bd;
    border-style: dashed;
    background: transparent;
  }

  .tb-radar-note {
    margin-left: auto;
  }
</style>
