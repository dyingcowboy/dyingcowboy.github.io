---
import { site } from '../data/site';
import Icon from './Icon.astro';
const pathname = Astro.url.pathname;
const active = (href: string) => href === '/' ? pathname === '/' : !href.includes('?') && pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label={`${site.chineseName}，返回首页`}><span class="brand-mark" aria-hidden="true">{site.mark}<span>.</span></span><span class="brand-name">{site.name}<span>{site.chineseName} / {site.subtitle}</span></span></a>
    <p class="nav-section-label">{site.sidebar.label}</p>
    <nav class="site-nav" aria-label="主要导航">
      {site.navigation.map((item) => <a href={item.href} class:list={{ active: active(item.href) }} data-nav-category={item.category ?? ''} data-nav-path={item.href} aria-current={active(item.href) ? 'page' : undefined}><Icon name={item.icon} /><span>{item.label}</span><span class="nav-en">{item.en}</span></a>)}
    </nav>
    <div class="sidebar-bottom"><p class="sidebar-note">{site.sidebar.note.map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</p><a href={site.sidebar.aboutHref} class="sidebar-link"><Icon name="user" />{site.sidebar.aboutLabel}<Icon name="upRight" size={14} /></a><a href={site.links.github} class="sidebar-link"><Icon name="github" />GitHub<Icon name="upRight" size={14} /></a><span class="sidebar-caption">{site.sidebar.caption}</span></div>
  </div>
</header>
